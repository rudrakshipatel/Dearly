# ─────────────────────────────────────────────────────────────────────────────
# Dearly environment variables. Copy to .env.local for development.
# NEXT_PUBLIC_* values are sent to the browser — never put secrets in them.
# ─────────────────────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only. Needed for: payment webhooks, scheduled delivery worker, media cleanup, account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (international payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Razorpay (India) — key id is public (used by Checkout.js), secrets are server only
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Subscription plan ids created in the Razorpay dashboard (INR)
RAZORPAY_PLAN_PREMIUM_MONTHLY=plan_xxx
RAZORPAY_PLAN_PREMIUM_YEARLY=plan_xxx
RAZORPAY_PLAN_PRO_MONTHLY=plan_xxx
RAZORPAY_PLAN_PRO_YEARLY=plan_xxx

# Email (Resend) — scheduled delivery emails and group-card invitations
RESEND_API_KEY=re_xxx
EMAIL_FROM="Dearly <hello@your-domain.com>"

# Background jobs (Inngest). In development run: npx inngest-cli@latest dev
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Optional fallback scheduler (Vercel Cron → /api/cron/*), sent as "Authorization: Bearer <secret>"
CRON_SECRET=

# AI (optional — either provider). Keys stay on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Analytics (optional; only loaded after the visitor consents)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
